# Generic examples only. Binary reads process environment, not .env files.
PORT=4792
LISTEN_HOST=127.0.0.1
MEDIA_SHARED_SECRET=CHANGE_ME_UPLOAD_SECRET
GATEWAY_SECRET=CHANGE_ME_GATEWAY_SECRET
INTERNAL_SECURITY_SECRET=CHANGE_ME_INTERNAL_SECRET
SECURITY_CALLBACK_URL=http://app-server:4789/api/internal/security/incident
MEDIA_STORAGE_ROOT=/data/flama/media
MEDIA_STAGE_TTL_SECONDS=86400
MAX_UPLOAD_BYTES=20971520
MAX_IMAGE_DIMENSION=4096
MAX_IMAGE_PIXELS=16000000
IMAGE_RESIZE_DIMENSION=1600
ALLOWED_ORIGINS=https://app.example.com
# Optional exact IP/CIDR allowlist; use the VPN gateway address in private config.
TRUSTED_PROXIES=127.0.0.1

# 212: set worker to enable SVG generation; OV uses receiver with its own env.
STROKE_ROLE=disabled
STROKE_DATASET_ROOT=
STROKE_STORE_URL=http://wg-gateway:4793/internal/strokes
STROKE_STORE_SECRET=CHANGE_ME_STROKE_RECEIVER_SECRET
STROKE_STORAGE_ROOT=/data/flama/strokes
