# Cổng lắng nghe của Flama Media Service
PORT=4792

# Khóa bí mật chung (HMAC Secret) giữa Flama VPS và Media Service
# Bắt buộc thay đổi chuỗi ngẫu nhiên 64 ký tự an toàn trên production!
MEDIA_SHARED_SECRET=replace-with-a-very-strong-64-character-random-secret-key-1234567890

# Khóa bảo mật Gateway giữa OV (VPS chính) và 212
# Nginx trên OV sẽ đính kèm header 'X-Flama-Gateway-Secret' khi proxy sang 212
GATEWAY_SECRET=flama-internal-gateway-secret-from-ov-to-212

# Thư mục lưu trữ media trên ổ đĩa Máy 212
MEDIA_STORAGE_ROOT=/data/flama/media

# Giới hạn kích thước file upload tối đa (Bytes) - Mặc định 20MB
MAX_UPLOAD_BYTES=20971520

# Giới hạn kích thước ảnh tối đa (chống Decompression Bomb)
MAX_IMAGE_DIMENSION=4096
MAX_IMAGE_PIXELS=16000000

# Danh sách IP của OV được phép kết nối (nếu cần giới hạn cấp ứng dụng, cách nhau dấu phẩy)
# TRUSTED_PROXIES=10.0.0.1,192.168.1.10
